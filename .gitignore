# Minton Video Library - Git ignore rules
# Keep the Python source and Markdown guides in Git.
# Keep personal notes, downloaded media, caches and credentials OUT of Git.

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode / build / test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Editors, OS and temporary files
.idea/
.vscode/
.vs/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.bak

# Local environment, authentication, cookies and personal configuration
.env
.env.*
!.env.example
cookies.txt
*cookies*.txt
*.cookies
*.secret
*.key

# SQLite user state (settings / queue / per-video memos)
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Logs and downloaded data when the download folder is inside this repo
logs/
data/
downloads/
media/
videos/
*.log
*.log.*
*.part
*.part-*
*.ytdl
*.temp

# Video, audio, thumbnail, subtitles and yt-dlp metadata
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.m4v
*.flv
*.ts
*.mp3
*.m4a
*.opus
*.wav
*.srt
*.vtt
*.ass
*.ssa
*.lrc
*.info.json
*.description
*.jpg
*.jpeg
*.png
*.webp
*.avif
*.gif

# Note: Files in %LOCALAPPDATA%\MintonVideoLibrary are already outside
# the repository. Git ignore rules do not replace data backups.
